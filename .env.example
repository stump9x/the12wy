# Embedded PostgreSQL data directory. Keep this on persistent storage in production.
PGLITE_DATA_DIR=.data/pglite

# Public URL used for canonical and social metadata in production.
NEXT_PUBLIC_APP_URL=http://107.161.168.82:12500

# Docker host binding. Use 107.161.168.82 to bind only that interface,
# or 0.0.0.0 to listen on all interfaces. The app listens on container port 3000.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=12500

# Set true only when the public URL is served through HTTPS.
AUTH_COOKIE_SECURE=false
